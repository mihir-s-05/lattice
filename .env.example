# LATTICE Environment Variables
# Copy this file to .env and customize as needed

#=============================================================================
# LLM Provider Configuration
#=============================================================================

# Provider order for router LLM (comma-separated)
# Options: openai, groq, gemini-openai-compat, lmstudio
LATTICE_ROUTER_PROVIDER_ORDER=openai,groq,lmstudio

# Provider order for agent LLMs
LATTICE_AGENT_PROVIDER_ORDER=openai,gemini-openai-compat,lmstudio

# Force a single provider for both router + agents (optional)
# LATTICE_PROVIDER=openai

# OpenAI API configuration (recommended)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1  # default

# Groq API configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash-lite

# LM Studio local configuration
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gpt-oss-20b

#=============================================================================
# Execution Settings
#=============================================================================

# Execution mode: ladder (sequential), tracks (parallel), weave (hybrid)
LATTICE_MODE=weave

# Router policy: llm or policy
LATTICE_ROUTER_POLICY=llm

# Huddle mode: dialog or synthesis
LATTICE_HUDDLES=dialog

# Maximum router LLM steps per run
LATTICE_ROUTER_MAX_STEPS=32

# Model temperature
LATTICE_TEMPERATURE=0.2

# Provider networking controls (seconds)
# LATTICE_HTTP_TIMEOUT=180
# LATTICE_CONNECT_TIMEOUT=30
# LATTICE_RETRY_COUNT=5
# LATTICE_MAX_RETRY_DELAY=30

#=============================================================================
# RAG (Retrieval Augmented Generation)
#=============================================================================

# Enable/disable RAG
LATTICE_USE_RAG=true

# Minimum similarity score for RAG results (0.0-1.0)
LATTICE_RAG_MIN_SCORE=0.15

# Maximum files to ingest
LATTICE_RAG_MAX_INGEST=20

#=============================================================================
# Web Search Configuration
#=============================================================================

# Web search mode: auto, on, off
LATTICE_WEB_SEARCH=auto

# SearXNG adapter settings
LATTICE_WEB_SEARCH_ADAPTER_ENABLED=false
LATTICE_WEB_SEARCH_ADAPTER_SEARCH_BASE_URL=http://localhost:8080
LATTICE_WEB_SEARCH_ADAPTER_DEFAULT_ENGINES=google,duckduckgo
LATTICE_WEB_SEARCH_ADAPTER_LANGUAGE=en

# Firecrawl settings (optional, for better web extraction)
LATTICE_WEB_SEARCH_ADAPTER_FETCH_TYPE=trafilatura
# LATTICE_WEB_SEARCH_ADAPTER_FIRECRAWL_BASE_URL=
# LATTICE_WEB_SEARCH_ADAPTER_FIRECRAWL_API_KEY=

#=============================================================================
# Advanced Settings
#=============================================================================

# Custom runs directory (default: ~/.lattice/runs)
# LATTICE_RUNS_DIR=
# Workspace seeding: copy (default), empty/skip/none to start from an empty workspace
# LATTICE_WORKSPACE_SEED=copy
# Persistent command policy (comma-separated)
# LATTICE_COMMAND_ALLOWLIST=
# LATTICE_COMMAND_DENYLIST=

# OpenAI Responses API (gpt-5*) tuning
# LATTICE_RESPONSES_REASONING_EFFORT=medium  # none|minimal|low|medium|high|xhigh (model dependent)
# LATTICE_RESPONSES_REASONING_SUMMARY=auto   # auto|none (model dependent)
# LATTICE_RESPONSES_TEXT_VERBOSITY=medium    # low|medium|high
# LATTICE_RESPONSES_TRUNCATION=auto          # auto|disabled
# LATTICE_RESPONSES_PARALLEL_TOOL_CALLS=true
# LATTICE_RESPONSES_STORE=true               # store responses on OpenAI
# LATTICE_RESPONSES_INCLUDE=reasoning.encrypted_content
# LATTICE_PROMPT_CACHE_KEY=
# LATTICE_PROMPT_CACHE_RETENTION=

# GPT-OSS model parameters (for advanced tuning)
# LATTICE_GPTOSS_TEMPERATURE=0.2
# LATTICE_GPTOSS_TOP_K=40
# LATTICE_GPTOSS_TOP_P=0.95
# LATTICE_GPTOSS_MIN_P=0.05
